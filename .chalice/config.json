{
  "version": "2.0",
  "app_name": "chalice-s3deriv",
  "automatic_layer": true,
  "xray": false,
  "environment_variables": {
    "POWERTOOLS_SERVICE_NAME": "infx_derivative",
    "LOG_LEVEL": "WARN"
  },
  "stages": {
    "dev": {
      "lambda_memory_size": 4096,
      "tags": {
        "Unit": "DevOps"
      },
      "environment_variables": {
        "SQS_QUEUE_DERIV": "infx_deriv_gen",
        "SQS_QUEUE_PDF": "infx_pdf_gen",
        "S3_BUCKET": "ul-bagit",
        "LAMBDA_MAX_MEMORY_FOR_DERIV":"4294967296"
      },
      "api_gateway_stage": "api",
      "lambda_functions": {
        "resize_individual": {
          "tags": {
            "Product": "Derivative Generation"
          },
	  "environment_variables": {
            "LAMBDA_MAX_MEMORY_FOR_DERIV":"4294967296"
	  }
        },
        "deriv_generator": {
          "tags": {
            "Product": "Derivative Generation"
          },
	  "environment_variables": {
            "LAMBDA_MAX_MEMORY_FOR_DERIV":"4294967296"
	  }
        },
        "pdf_generator": {
          "tags": {
            "Product": "PDF Generation"
          },
        }
      }
    }
  }
}
